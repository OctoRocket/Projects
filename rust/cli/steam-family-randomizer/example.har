            "text": "@import url(https://cdn.jsdelivr.net/npm/firacode@6.2.0/distr/fira_code.css);\n\n@font-face {\n  font-family: \"G.B.BOOT\";\n  src: url(\"/fonts/GBBoot/Gbboot-ALpM.ttf\");\n}\n\n@font-face {\n  font-family: \"Gossamer Girls\";\n  src: url(\"/fonts/GossamerGirls/GossamerGirlsRegular-dBn7.ttf\");\n}\n\n@font-face {\n  font-family: \"Home Video\";\n  src: url(\"/fonts/HomeVideo/HomeVideo-BLG6G.ttf\");\n}\n\n.home-video {\n  font-family: \"Home Video\", monospace;\n}\n\n.title-intro-text {\n  margin-top: 0;\n  text-align: center;\n}\n\n.description {\n  font-family: \"G.B.BOOT\", monospace;\n  color: var(--dim);\n}\n\n.main-section {\n  margin-bottom: 2rem;\n}\n\n.blog-container > div {\n  margin-bottom: 2rem;\n  padding: 1rem;\n}\n\n.blog-header {\n  border: none;\n  border-bottom: 3px var(--teal) solid;\n  display: flex;\n  flex-direction: row;\n  row-gap: 100px;\n  backdrop-filter: none;\n  -webkit-backdrop-filter: none;\n  margin: inherit 100%;\n}\n\n.blog-header * {\n  width: 100%;\n  margin-top: 0;\n  margin-bottom: 0.5rem;\n}\n\n.blog-header > .description {\n  text-align: right;\n}\n\n.clear {\n  border: transparent 0px;\n  -webkit-backdrop-filter: none;\n  backdrop-filter: none;\n}\n\n.container {\n  display: flex;\n}\n\n.column {\n  display: flex;\n  flex-direction: column;\n}\n\n.text-holding {\n  padding: 0rem 1rem;\n}\n\n.todo {\n  color: var(--yellow);\n}\n\n#title-title {\n  font-size: x-large;\n}\n\n#title {\n  background: transparent;\n  display: flex;\n  flex-direction: column;\n}\n\n#title-name {\n  font-family: \"Gossamer Girls\", monospace;\n  font-size: 30pt;\n}\n\n#warning {\n  border-color: var(--red);\n}\n\n#under-construction {\n  border-color: var(--yellow);\n}\n\n#update-tracker {\n  padding: 0;\n  border: 0;\n  margin: 0.25rem 0;\n  justify-content: space-between;\n}\n\n#update-tracker p {\n  margin: 0;\n}\n\n@media print, (max-width: 70rem) {\n  #outer-bound {\n    width: 70rem;\n  }\n}\n\n@media screen and (min-width: 1300px) {\n  #outer-bound {\n    width: 90%;\n  }\n}\n\n@media screen and (min-width: 85rem) {\n  #outer-bound {\n    width: 85rem;\n  }\n}\n\n\n#outer-bound {\n  margin: 6rem auto;\n}\n\n#right-column {\n  margin-left: 1rem;\n  width: 60%;\n}\n\n#right-column > div {\n  border-color: var(--teal);\n  padding: 0rem 1rem;\n  margin-bottom: 1rem;\n}\n\n#left-column {\n  width: 40%;\n  margin-right: 1rem;\n  color: var(--dim);\n}\n\n#left-column > div {\n  background-color: var(--rock);\n  padding: 1rem;\n  margin-bottom: 1rem;\n}\n\n#status-box p {\n  padding-right: 0.5rem;\n  margin: auto;\n}\n\n#status-box marquee {\n  width: 100%;\n  border-left: 3px solid var(--purple);\n  border-right: 3px solid var(--purple);\n}\n\n.paper {\n  background-color: var(--paper);\n  color: var(--dark-gray);\n}\n\n:root {\n  /* vars */\n  --paper: #fffffa;\n  --rock: #48473c;\n  --dark-gray: #3C4142;\n  --dim: #dddddd;\n  --purple: #6410cc;\n  --teal: #11cc66;\n  --red: #cc1077;\n  --yellow: #dddd10;\n  --info-tint: #acd58c;\n\n  color: #fff;\n  font-family: \"Fira Code\", monospace;\n  font-optical-sizing: auto;\n  font-weight: 500;\n}\n\nbody {\n  background-color: var(--dark-gray);\n  background-image: url(/background.png);\n  background-repeat: no-repeat;\n  background-size: cover;\n  background-attachment: fixed;\n  background-position: center;\n}\n\ndiv {\n  border: 0.25rem solid var(--purple);\n  -webkit-backdrop-filter: brightness(60%) blur(25px);\n          backdrop-filter: brightness(60%) blur(25px);\n}\n\nh1 {\n  font-family: \"Home Video\", monospace;\n  text-align: center;\n}\n\nh3 {\n  font-family: \"Home Video\", monospace;\n  font-size: x-large;\n  font-weight: normal;\n  text-align: left;\n}\n\nmarquee {\n  align-content: center;\n  overflow: scroll;\n}\n\np {\n  text-align: justify;\n}\n\nul {\n  list-style-type: \"— \";\n}\n\nli::marker {\n  font-weight: bolder;\n}\n\na {\n  text-decoration: none;\n}\n\na:link {\n  color: var(--teal);\n}\n\na:visited {\n  color: var(--teal);\n}\n\na:active {\n  color: var(--red);\n}\n\na:hover {\n  color: var(--purple);\n}\n"
